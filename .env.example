# Bureau Environment Variables
# Copy this file to .env.local and fill in your actual values

# ============================================================================
# DATABASE (Required)
# ============================================================================
# PostgreSQL connection string (with connection pooler)
# Get from Supabase: Project Settings > Database > Connection string (Session mode)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT].supabase.co:5432/postgres

# PostgreSQL admin connection string (direct connection)
# Get from Supabase: Project Settings > Database > Connection string (Direct connection)
DATABASE_URL_ADMIN=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT].supabase.co:5432/postgres

# ============================================================================
# AUTHENTICATION (Choose one: Supabase for production, or Local for development)
# ============================================================================

# --- Supabase Auth (Production - uses built-in magic link emails) ---
# Get from Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://[YOUR-PROJECT].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- Local Auth (Development - logs magic links to console) ---
# If Supabase vars above are NOT set, app uses local auth with database sessions

# ============================================================================
# SITE URL (Recommended for production)
# ============================================================================
# Your production URL (for redirect links in emails)
# If not set, uses VERCEL_URL or request origin
NEXT_PUBLIC_SITE_URL=https://bureau.yourdomain.com

# ============================================================================
# ENCRYPTION (Required for production)
# ============================================================================
# 32+ character encryption key for credential storage (AES-256)
# Generate with: openssl rand -base64 32
BUREAU_ENCRYPTION_KEY=your-32-char-encryption-key-change-in-production

# ============================================================================
# LLM REVIEW (Optional - requires API keys)
# ============================================================================
# Enable LLM-powered weekly review insights (disabled by default)
BUREAU_ENABLE_LLM_REVIEW=false

# OpenAI API key (if LLM review enabled)
OPENAI_API_KEY=sk-proj-...

# Anthropic API key (if LLM review enabled)
ANTHROPIC_API_KEY=sk-ant-...

# ============================================================================
# AUTOMATIC VERCEL VARIABLES (Set by Vercel, do not add manually)
# ============================================================================
# VERCEL_URL - Automatically set by Vercel (deployment URL)
# NODE_ENV - Automatically set (development, production, test)
