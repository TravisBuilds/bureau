{
  "display_information": {
    "name": "Bureau Digital Clone",
    "description": "Connect your team's digital clones to Slack for async coordination",
    "background_color": "#2c3e50"
  },
  "features": {
    "app_home": {
      "home_tab_enabled": false,
      "messages_tab_enabled": true,
      "messages_tab_read_only_enabled": false
    },
    "bot_user": {
      "display_name": "Bureau",
      "always_online": true
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "app_mentions:read",
        "chat:write",
        "users:read",
        "channels:read"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "request_url": "https://bureau-krustbuild.vercel.app/api/slack/events",
      "bot_events": [
        "app_mention"
      ]
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
